{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "outDir": "../../generator/bidoc_generator/offline_static",
    "rootDir": "src",
    "newLine": "lf",
    "removeComments": false
  },
  "include": [
    "src/offline.ts",
    "src/search.ts",
    "src/protocol.ts"
  ]
}
