{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "outDir": "../bidoc_generator/desktop/static",
    "rootDir": "src",
    "newLine": "lf",
    "removeComments": false
  },
  "include": ["src/**/*.ts"]
}
